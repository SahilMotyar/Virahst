# Copy this file to .env.local. Every value is optional — the site runs without any of them.

# Absolute site URL, used for Open Graph / Twitter link previews.
NEXT_PUBLIC_SITE_URL=

# Spotify playlist for the ambient music bar, as spotify:playlist:<id>.
# Falls back to the default in src/config.ts.
NEXT_PUBLIC_SPOTIFY_PLAYLIST_URI=

# Only used by `npm run gen:playlist` to fetch album art when regenerating
# src/data/playlistTracks.ts. Never read by the running site. Keep these private.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
