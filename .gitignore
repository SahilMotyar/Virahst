# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# fetched image candidates (curation scratch — winners go to public/items/)
/data/asset-candidates/

# Excalidraw fonts, copied out of node_modules by predev/prebuild
/public/fonts/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel / netlify (local CLI state)
.vercel
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts
